# Copy to .env for local runs (never commit .env). On Render, set these under the service's Environment.
NODE_ENV=production
SESSION_SECRET=any-long-random-text
# Neon (or any Postgres) connection string. Leave out locally to keep data in data/local.json.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Google sign-in: an OAuth client of type "Web application" in a Google Cloud project of recykal.com.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The public address. Render sets RENDER_EXTERNAL_URL automatically, so this is only needed for a custom domain.
# BASE_URL=https://brand.recykal.com
# Optional email (Gmail with an app password). Without these, email is skipped and the in-app bell still works.
SMTP_USER=
SMTP_PASS=
# Set to 0 to stop asking for read access to Google Drive (then Google links can't be checked; uploads still can).
# GOOGLE_DRIVE=0
# Local testing only (no Google client set): sign in as any @recykal.com address.
# DEV_LOGIN=1
